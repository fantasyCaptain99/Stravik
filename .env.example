# ─── Site ────────────────────────────────────────────────────────────────────
# Production origin, no trailing slash. Used for canonical URLs, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://stravik.com

# ─── Contact form email (Resend) ─────────────────────────────────────────────
# Get a key at https://resend.com/api-keys
# If RESEND_API_KEY is unset, the contact form returns an honest "not configured"
# error instead of a fake success. It never pretends a message was delivered.
RESEND_API_KEY=
# Verified sender domain in Resend, e.g. "Stravik <hello@stravik.com>"
CONTACT_FROM_EMAIL=
# Where inquiries are delivered.
CONTACT_TO_EMAIL=

# ─── Spam protection (Cloudflare Turnstile) ──────────────────────────────────
# https://dash.cloudflare.com/?to=/:account/turnstile
# If unset, the widget is skipped and the server-side check is bypassed.
# The honeypot field stays active either way.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
